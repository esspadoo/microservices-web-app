@startuml
actor Client

package "Importer Application" {

    component "ImporterController\n(REST API)" as Controller
    component "ImporterService\n(Business Logic)" as Service
    component "ElasticsearchClient_Importer\n(Indexing Component)" as ESImporter
    component "ElasticConfig\n(Configuration)" as Config
}

package "Elasticsearch Infrastructure" {

    component "ElasticsearchClient\n(High-level API)" as ESClient
    component "RestClient\n(Low-level HTTP)" as RestClient
}

' --- Interactions ---

Client --> Controller : HTTP requests

Controller --> Service : invoke import / status
Service --> ESImporter : delegate indexing

Config --> ESClient : creates bean
Config --> RestClient : creates bean

ESImporter --> ESClient : bulk index operations
ESImporter --> RestClient : connection management

@enduml

