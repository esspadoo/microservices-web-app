@startuml
title Project Component Diagram - Searcher & Inferer Services

skinparam FontSize 14

' ==== Searcher Service ====

package "Searcher Service" {

    [SearchController] --> [SearchService]
    [SearchController] --> [DocumentService]
    [SearchController] --> [InfererClient]

    [DocumentService] --> [DocumentRepository]
    [DocumentRepository] --> [MongoDB]

    [SearchService] --> [ElasticsearchClient]
}

' ==== Inferer Service ====

package "Inferer Service" {

    [InfererController] --> [DocService]
    [DocServiceImpl] ..|> [DocService]
    [DocServiceImpl] --> [JsonInferencerService]

    [JsonInferencerService] --> [MALLET Topic Inferencer]
}

' ==== External Systems ====

[MongoDB] <<database>>
[Elasticsearch] <<database>>
[MALLET Topic Inferencer] <<external>>

[ElasticsearchClient] --> [Elasticsearch]

' ==== Inter-service Communication ====

[InfererClient] --> [InfererController]

@enduml

