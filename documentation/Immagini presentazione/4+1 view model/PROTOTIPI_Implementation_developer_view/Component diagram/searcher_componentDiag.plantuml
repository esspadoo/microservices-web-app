@startuml

package "Search Application" {

    component "SearchController\n(REST API)" as SearchController

    component "SearchService\n(Business Logic)" as SearchService
    component "DocumentService\n(Cache Management)" as DocumentService

    component "ElasticsearchClient_Search\n(Search Adapter)" as ESClient
    component "InfererClient\n(External Service Client)" as InfererClient

    component "DocumentRepository\n(MongoDB)" as DocumentRepository

    component "DTOs\n(Document, CacheDocument)" as DTOs

    component "Configuration\n(Spring Boot)" as Config
}

' --- Component dependencies ---

SearchController --> SearchService
SearchController --> DocumentService
SearchController --> InfererClient
SearchController --> DTOs

SearchService --> ESClient
SearchService --> DTOs

DocumentService --> DocumentRepository
DocumentService --> DTOs

InfererClient --> DTOs
InfererClient --> Config

ESClient --> DTOs
ESClient --> Config

DocumentRepository --> Config

@enduml

