@startuml
skinparam nodesep 120
skinparam ranksep 80

title Package Diagram - Searcher, Importer & Inferer Modules

package "it.unipd" {

    ' --- MODULO SEARCHER ---
    package "search" {
        package "it.unipd.search.api" as search_api {
            [SearchController]
        }
        package "it.unipd.search.service" as search_service {
            [SearchService]
            [DocumentService]
        }
        package "it.unipd.search.repository" as search_repo {
            [DocumentRepository]
        }
        package "it.unipd.search.dto" as search_dto {
            [Document]
            [CacheDocument]
        }
        package "it.unipd.search.client" as search_client {
            [InfererClient]
        }
        package "it.unipd.search.config" as search_config {
            [ElasticsearchBeansConf]
            [ElasticsearchProperties]
            [InfererProperties]
        }
        
        [ElasticsearchClient_Search] as search_es_client
        [SearchApplication] as search_app
    }

    ' --- MODULO IMPORTER ---
    package "importer" {
        package "it.unipd.importer.api" as imp_api {
            [ImporterController]
        }
        package "it.unipd.importer.service" as imp_service {
            [ImporterService]
        }
        package "it.unipd.importer.config" as imp_config {
            [ElasticConfig]
        }
        
        [ElasticsearchClient_Importer] as imp_es_client
        [ImporterApplication] as imp_app
    }

    ' --- MODULO INFERER ---
    package "inferer" {
        package "it.unipd.inferer.api" as inf_api {
            [InfererController]
        }
        package "it.unipd.inferer.service" as inf_service {
            interface DocService
            [DocServiceImpl]
            [JsonInferencerService]
        }
        package "it.unipd.inferer.dto" as inf_dto {
            [Document] as InfDoc
        }
        package "it.unipd.inferer.config" as inf_config {
            [OpenApiConfig] as InfOpenApi
        }
    }
}

' --- DIPENDENZE SEARCHER ---
search_api --> search_service : use
search_api --> search_client : use
search_api --> search_dto : use
search_service --> search_repo : use
search_service --> search_es_client : use
search_service --> search_dto : use
search_repo --> search_dto : use
search_client --> search_config : use
search_client --> search_dto : use
search_es_client --> search_dto : use

' --- DIPENDENZE IMPORTER ---
imp_api --> imp_service : use
imp_service --> imp_es_client : use

' --- DIPENDENZE INFERER ---
inf_api --> inf_service : use
inf_api --> inf_dto : use
inf_service --> inf_dto : use

' --- DIPENDENZE INTER-MODULO (Logiche via Rete) ---
search_client ..> inf_api : HTTP Post (inferBatch)

@enduml
