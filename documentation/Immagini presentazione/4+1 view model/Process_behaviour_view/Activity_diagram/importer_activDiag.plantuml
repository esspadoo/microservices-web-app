@startuml
skinparam ActivityFontSize 12
skinparam ActivityDiamondFontSize 12
skinparam ArrowColor #2C3E50

title Activity Diagram - Importing System 

|#AliceBlue|User/Admin|
start
:Upload NDJSON File;

|#HoneyDew|Importer Module (Controller)|
:Validate File Format;
if (Is Valid JSONL?) then (No)
  :Return 400 Bad Request;
  stop
else (Yes)
  :Generate Job ID;
  :Trigger Asynchronous Process (@Async);
  detach
endif

|#HoneyDew|Importer Module (Service)|
:Check Elasticsearch Index;
if (Index Exists?) then (No)
  :Create New Index;
endif
:Stream JSON Lines;
:Execute Bulk Ingest (BulkIngester);
:Update Job Status (COMPLETED/FAILED);
stop
@enduml
