@startuml

skinparam sequenceParticipant underline 
skinparam {
  ' Overall style
  FontSize 14

  ' Colors
  ArrowColor #000000
  ArrowFontColor #000000
  BackgroundColor #FFFFFF
  BorderColor #DEDEDE
  FontColor #333333

  ' Participant styling
  Participant {
    BorderColor #0077B6
    BackgroundColor #F0F8FF
    FontColor #005691
  }

  ' Actor styling
  Actor {
    BorderColor #6A057F
    BackgroundColor #F5EEF8
    FontColor #510363
  }

  ' Sequence specific
  Sequence {
    ArrowThickness 2
    LifeLineBorderColor #444444
    LifeLineBackgroundColor #F7F7F7
    BoxBorderColor #AAAAAA
    BoxBackgroundColor #FFFFFF
    BoxFontColor #333333
  }
}




actor Client
participant "ImporterController" as Controller
participant "ImporterService" as Service
participant "ElasticsearchClient_Importer" as ESClient
participant "BulkIngester" as Ingester
participant "ElasticsearchClient" as ES

Client -> Controller: POST /api/v1/importer/import\nfile + indexName
Controller -> Service: indexArticles(file.getInputStream(), indexName)
activate Service

Controller --> Client: ResponseEntity.ok("Import avviato")

Service -> ESClient: bulkIndexWithContext(file, indexName)
activate ESClient

ESClient -> ES: indices().exists(indexName)
ES --> ESClient: boolean

alt indice non esiste
    ESClient -> ES: indices().create(indexName)
    ES --> ESClient: result
end

ESClient -> ESClient: Apri BufferedReader sul file
ESClient -> Ingester: BulkIngester.of(...)

loop per ogni riga
    ESClient -> ESClient: valida riga (deve iniziare con "{")
    ESClient -> ESClient: crea BinaryData
    ESClient -> Ingester: ingester.add(document)
end

ESClient --> Service: void
deactivate ESClient

Service --> Controller: void
deactivate Service
@enduml

