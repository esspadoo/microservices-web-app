@startuml

skinparam sequenceParticipant underline 
skinparam {
  ' Overall style
  FontSize 14

  ' Colors
  ArrowColor #000000
  ArrowFontColor #000000
  BackgroundColor #FFFFFF
  BorderColor #DEDEDE
  FontColor #333333

  ' Participant styling
  Participant {
    BorderColor #0077B6
    BackgroundColor #F0F8FF
    FontColor #005691
  }

  ' Actor styling
  Actor {
    BorderColor #6A057F
    BackgroundColor #F5EEF8
    FontColor #510363
  }

  ' Sequence specific
  Sequence {
    ArrowThickness 2
    LifeLineBorderColor #444444
    LifeLineBackgroundColor #F7F7F7
    BoxBorderColor #AAAAAA
    BoxBackgroundColor #FFFFFF
    BoxFontColor #333333
  }
}

title Inferer Module - Sequence Diagram

actor "Searcher Service" as SEARCHER

participant "InfererController" as IC
participant "DocServiceImpl" as DSI
participant "JsonInferencerService" as JIS
participant "Mallet TopicInferencer\n(ParallelTopicModel)" as MALLET

== Batch topic inference ==

SEARCHER -> IC : POST /api/v1/inferBatch\nList<Document>
activate IC

IC -> DSI : inferBatch(documents)
activate DSI

loop for each Document
    DSI -> JIS : inferPrevalentTopicJsonl(document)
    activate JIS

    JIS -> MALLET : getSampledDistribution(instance)
    activate MALLET
    MALLET --> JIS : topic distribution
    deactivate MALLET

    JIS --> DSI : Document (with inferred topic)
    deactivate JIS
end

DSI --> IC : List<Document>
deactivate DSI

IC --> SEARCHER : HTTP 200 OK\nJSON List<Document>

== Exception propagation ==

opt RuntimeException / IOException
    IC --> SEARCHER : HTTP 500 Internal Server Error
    deactivate IC
end

@enduml

