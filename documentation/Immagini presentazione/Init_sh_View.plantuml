@startuml
title Application Init – Execution Flow

start

:Parse CLI arguments;
note right
--model-update
--guardian-force
end note

if (Model exists\nAND --model-update is false?) then (Yes)
  :Use existing ML model;
else (No)
  :Download ML model\nfrom Hugging Face;
endif

:Compile project\n(compileProject.sh);

if (guardian.jsonl exists\nAND --guardian-force is false?) then (Yes)
  :Skip Guardian crawler;
else (No)
  :Run Guardian crawler\n(guardianCrawler.sh);
endif

:Initialize Python environment\n(py_init.sh);

:Build & start services\nDocker Compose (--build -d);

while (Importer not ready?) is (F: Waiting)
  :Check importer service\nGET /api/v1/importer/hello;
endwhile

:Import Guardian dataset\nPOST api/v1/importer/import;

while (Importer not ready?) is (F: Waiting)
  :Check importer service\nGET /api/v1/importer/hello;
endwhile

:Import OWI dataset\nPOST api/v1/importer/import;

:Application ready\nOpen http://localhost:8080/;

stop
@enduml