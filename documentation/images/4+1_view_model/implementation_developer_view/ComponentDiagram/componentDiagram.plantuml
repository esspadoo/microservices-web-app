@startuml
' Layout impostato per evitare incroci di linee
skinparam componentStyle uml2
skinparam nodesep 80
skinparam ranksep 60

title Searcher, importer and inferer's Component Diagram

' --- INTERFACCE ---
interface "Search API" as ISearch
interface "Importer API" as IImp
interface "Inferer API" as IInf
interface "Elastic API" as IES
interface "Mongo API" as IMongo

' --- INFRASTRUTTURA ---
node "Access Layer" #line.dashed {
    [Nginx Proxy] as NG <<Proxy>> #white
    [Swagger UI] as SW <<Documentation>> #white
}

' --- MODULO INFERER ---
package "it.unipd.inferer" {
    component "Inferer Engine" as ModInf <<Component>> #fff9ee {
        portin "REST In" as pInfIn
        [InfererController] as InfCtrl
        [DocServiceImpl] as DocSrv
        
        pInfIn -down- InfCtrl
        InfCtrl -down-> DocSrv
    }
}

' --- MODULO SEARCHER ---
package "it.unipd.search" {
    component "Searcher Core" as ModSearch <<Component>> #f9f9f9 {
        portin "REST In" as pSeaIn
        portout "DB/Service Out" as pSeaOut
        
        [SearchController] as SeaCtrl
        [SearchService] as SeaSrv
        [DocumentService] as DocSrvSearch
        [InfererClient] as InfCli
        
        pSeaIn -down- SeaCtrl
        SeaCtrl -down-> SeaSrv
        SeaCtrl -down-> DocSrvSearch
        SeaCtrl -down-> InfCli
        
        SeaSrv -down- pSeaOut
        DocSrvSearch -down- pSeaOut
        InfCli -down- pSeaOut
    }
}

' --- MODULO IMPORTER ---
package "it.unipd.importer" {
    component "Data Importer" as ModImp <<Component>> #eef9ff {
        portin "REST In" as pImpIn
        portout "DB Out" as pImpOut
        
        [ImporterController] as ImpCtrl
        [ImporterService] as ImpSrv
        
        pImpIn -down- ImpCtrl
        ImpCtrl -down-> ImpSrv
        ImpSrv -down- pImpOut
    }
}

' --- STORAGE ---
database "Elasticsearch" as ES <<Database>>
database "MongoDB" as Mongo <<Database>>

' --- CONNESSIONI E INTERFACCE (Notation: Ball-and-Socket) ---

' Connessioni Entry Point (Semicerchio richiede -> Cerchio fornisce)
NG --( ISearch
NG --( IImp
NG --( IInf

SW --( ISearch
SW --( IImp
SW --( IInf

' Mapping Porte -> Interfacce Fornite (Cerchio)
pSeaIn -up- ISearch
pImpIn -up- IImp
pInfIn -up- IInf

' Mapping Porte -> Interfacce Richieste (Semicerchio)
pSeaOut --( IES
pSeaOut --( IMongo
pSeaOut --( IInf : "internal call"

pImpOut --( IES

' Mapping Interfacce Fornite dai Database
IES -down- ES
IMongo -down- Mongo

@enduml
